{
    "meta": {
        "version": 2,
        "flow": "Classic",
        "substituting_steps": {
            "Odb.ApplyDEFTemplate": null,
            "-OpenROAD.GeneratePDN": "Odb.ApplyDEFTemplate"
        }
    },
    "// power.json": "VDD_NETS, GND_NETS and PDN_MACRO_CONNECTIONS come from power.json, which must be passed to LibreLane before this file.",
    "DESIGN_NAME": "openframe_project_wrapper",
    "VERILOG_DEFINES": [
        "PnR"
    ],
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/openframe_project_netlists.v",
        "dir::../../verilog/rtl/openframe_project_wrapper.v",
        "dir::../../verilog/rtl/openframe_gpio.v",
        "dir::../../ip/CF_gpio_config/rtl/CF_gpio_config.v"
    ],
    "VERILOG_POWER_DEFINE": "USE_POWER_PINS",
    "MACROS": {
        "user_proj_timer": {
            "instances": {
                "mprj": {
                    "location": [2850, 235],
                    "orientation": "FN"
                },
                "mprj2": {
                    "location": [116, 235],
                    "orientation": "N"
                }
            },
            "gds": ["dir::../../gds/user_proj_timer.gds"],
            "lef": ["dir::../../lef/user_proj_timer.lef"],
            "nl": ["dir::../../verilog/gl/user_proj_timer.v"],
            "pnl": ["dir::../../verilog/gl/user_proj_timer.v"],
            "lib": {
                "*": ["dir::../../lib/user_proj_timer.lib"]
            },
            "spef": {
                "min_*": ["dir::../../spef/multicorner/user_proj_timer.min.spef"],
                "nom_*": ["dir::../../spef/multicorner/user_proj_timer.nom.spef"],
                "max_*": ["dir::../../spef/multicorner/user_proj_timer.max.spef"]
            }
        }
    },
    "SYNTH_ELABORATE_ONLY": true,
    "ERROR_ON_NL_ASSIGN_STATEMENTS": false,
    "ERROR_ON_SYNTH_CHECKS": false,
    "MAX_TRANSITION_CONSTRAINT": 0.5,
    "RUN_POST_GPL_DESIGN_REPAIR": false,
    "RUN_POST_CTS_RESIZER_TIMING": false,
    "GRT_RESIZER_TIMING_OPTIMIZATIONS": false,
    "GRT_RESIZER_DESIGN_OPTIMIZATIONS": false,
    "DESIGN_REPAIR_BUFFER_INPUT_PORTS": false,
    "RUN_CTS": false,
    "RUN_ANTENNA_REPAIR": false,
    "// DRT_ANTENNA_REPAIR_ITERS": "The wrapper has no stdcell rails or taps, so router-inserted diodes would be unpowered; at chip level these nets end on pad diffusion.",
    "DRT_ANTENNA_REPAIR_ITERS": 0,
    "RUN_HEURISTIC_DIODE_INSERTION": false,
    "RUN_FILL_INSERTION": false,
    "RUN_TAP_ENDCAP_INSERTION": false,
    "RUN_IRDROP_REPORT": false,
    "RUN_LINTER": false,
    "RUN_LVS": true,
    "// MAGIC_EXT_ABSTRACT_CELLS": "User macros are extracted as black boxes: separate ground domains share the p-substrate, so a flat extraction merges them. Each macro gets its own LVS when it is hardened; cf precheck runs full LVS with EXTRACT_CREATE_SUBCUT (lvs/openframe_project_wrapper/lvs_config.json). List every user macro here and in that file.",
    "MAGIC_EXT_ABSTRACT_CELLS": [
        "^user_proj_timer$"
    ],
    "LVS_INCLUDE_MARCO_NETLISTS": false,
    "MAGIC_ZEROIZE_ORIGIN": false,
    "MAGIC_DEF_LABELS": false,
    "MAGIC_EXT_USE_GDS": true,
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 3166.63, 4766.63],
    "CORE_AREA": [60, 60, 3106.63, 4706.63],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/openframe_project_wrapper.def",
    "FP_TEMPLATE_COPY_POWER_PINS": true,
    "PDN_CFG": "dir::pdn_cfg.tcl",
    "PDN_MULTILAYER": true,
    "PDN_ENABLE_RAILS": false,
    "PDN_ENABLE_PINS": false,
    "PDN_VWIDTH": 3.1,
    "PDN_HWIDTH": 3.1,
    "PDN_VSPACING": 15.5,
    "PDN_HSPACING": 15.5,
    "PDN_VPITCH": 180,
    "PDN_HPITCH": 180,
    "PDN_VOFFSET": 5,
    "PDN_HOFFSET": 5,
    "PDN_CORE_RING": true,
    "PDN_CORE_RING_VWIDTH": 5,
    "PDN_CORE_RING_HWIDTH": 5,
    "PDN_CORE_RING_VSPACING": 1.7,
    "PDN_CORE_RING_HSPACING": 1.7,
    "PDN_CORE_RING_VOFFSET": 2,
    "PDN_CORE_RING_HOFFSET": 2
}
